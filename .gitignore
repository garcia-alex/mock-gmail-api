# Sample fixtures.sqlite at the repo root IS committed intentionally (see
# README) so `make serve` works with zero setup. Only ignore fixture DBs
# generated elsewhere (e.g. by tests or ad-hoc `generate --db` runs).
/*.db
!/fixtures.sqlite

