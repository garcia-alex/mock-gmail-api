PYTHON_REPO="mock-gmail-api"

# Copy to .env and adjust as needed. All variables are optional.

# If unset, the server accepts any nonempty bearer token.
MOCK_GMAIL_DEV_TOKEN=dev-secret-token

# Path to the SQLite fixture database.
MOCK_GMAIL_DB=./fixtures.sqlite

# Comma-separated fault names (rate-limit,timeout,malformed,duplicate-page)
# or "none".
MOCK_GMAIL_FAULTS=none

# Probability [0, 1] that an eligible request trips one of the enabled faults.
MOCK_GMAIL_FAULT_CHANCE=0.05

# Seed used by `generate --if-missing` inside the Docker entrypoint.
MOCK_GMAIL_SEED=42
